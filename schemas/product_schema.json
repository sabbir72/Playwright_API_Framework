{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "type": "object",

  "required": [
    "id",
    "title",
    "price",
    "category",
    "stock"
  ],

  "properties": {

    "id": {
      "type": "integer"
    },

    "title": {
      "type": "string"
    },

    "price": {
      "type": "number"
    },

    "category": {
      "type": "string"
    },

    "stock": {
      "type": "integer"
    }

  }
}